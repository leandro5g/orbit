{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "remotion.config.ts"
  ],
  "include": [
    "src",
    "../src/renderer/src/env.d.ts"
  ]
}
